# fake: a built-in fake Maytas with sample data, to try Mayfly. live: the real Maytas Hub.
MAYTAS_MODE=fake
# The Maytas Hub address. Only the University of Chichester's Maytas is supported.
MAYTAS_URL=https://apprenticeships.chi.ac.uk/etrack
# Your Maytas username. Required only when MAYTAS_MODE=live.
MAYTAS_USERNAME=
# Your Maytas password. Required only when MAYTAS_MODE=live. Mayfly sends it only to Maytas.
MAYTAS_PASSWORD=

# The address Mayfly listens on. 127.0.0.1 means only this machine can reach it.
MAYFLY_HOST=127.0.0.1
# The port of the web app and the MCP server.
MAYFLY_PORT=4747
# Access token, at least 16 characters. Required when MAYFLY_HOST is not 127.0.0.1 or localhost. Make one with: openssl rand -hex 32
MAYFLY_TOKEN=
# The folder for your data. Keep fake and live data apart: use ./data-fake for fake mode and ./data for live mode.
MAYFLY_DATA_DIR=./data-fake
